    "html": "<html lang=\"en\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Healio</title>\n\n    <meta name=\"description\" content=\"Healio  is a trusted healthcare center providing professional doctors, modern medical services, and online appointment booking.\">\n    <meta name=\"keywords\" content=\"hospital, healthcare, doctors, medical services, appointment booking\">\n    <link rel=\"preload\" as=\"image\" href=\"Images/doctor_home.jpg\">\n    <link rel=\"stylesheet\" href=\"Css/all.css\">\n    <link rel=\"shortcut icon\" href=\"Images/healioIcon2.png\" type=\"image/x-icon\">\n    <!-- <link rel=\"stylesheet\" href=\"Css/style_min.css\"> -->\n    <link rel=\"stylesheet\" href=\"Css/style.css\">\n</head>\n<body>\n\n    <!-- HEADER -->\n    <header class=\"header\">\n        <a href=\"#\" class=\"logo\">\n            <img src=\"Images/healioIcon2.png\" width=\"40\" height=\"40\" alt=\"Healio\"> Healio \n        </a>\n\n        <nav class=\"navbar\">\n            <a href=\"#home\">Home</a>\n            <a href=\"#services\">Services</a>\n            <a href=\"#our-story\">Our story</a>\n            <a href=\"#doctors\">Doctors</a>\n            <a href=\"#book\">Appointment</a>\n            <a href=\"#review\">Reviews</a>\n            <a href=\"#blogs\">Blog</a>\n        </nav>\n        <div id=\"theme-toggle\" aria-label=\"Toggle theme\" role=\"button\">\n            <span class=\"toggle-track\">\n                <span class=\"toggle-thumb\"></span>\n            </span>\n        </div>\n        <button id=\"menu-btn\" class=\"fas fa-bars\" aria-label=\"Toggle navigation\"></button>\n    </header>\n\n    <!-- HOME -->\n    <main>\n        <section class=\"home\" id=\"home\">\n            <div class=\"image\">\n                <img src=\"Images/doctor_home.jpg\" alt=\"Modern medical healthcare environment\">\n            </div>\n            <div class=\"content\">\n                <h3>Your Health Is Our Priority</h3>\n                <p>\n                    Healio  provides high-quality medical services with experienced doctors,\n                    advanced technology, and compassionate care.\n                </p>\n                <a href=\"#book\" class=\"btn\">\n                    Book Appointment <span class=\"fas fa-chevron-right\"></span>\n                </a>\n            </div>\n        </section>\n    </main>\n\n    <!-- STATS -->\n    <section class=\"icons-container\">\n        <div class=\"icons\">\n            <i class=\"fas fa-user-md\"></i>\n            <h3>120+</h3>\n            <p>Qualified Doctors</p>\n        </div>\n        <div class=\"icons\">\n            <i class=\"fas fa-procedures\"></i>\n            <h3>500+</h3>\n            <p>Successful Treatments</p>\n        </div>\n        <div class=\"icons\">\n            <i class=\"fas fa-hospital\"></i>\n            <h3>15+</h3>\n            <p>Medical Departments</p>\n        </div>\n        <div class=\"icons\">\n            <i class=\"fas fa-smile\"></i>\n            <h3>10k+</h3>\n            <p>Satisfied Patients</p>\n        </div>\n    </section>\n\n    <!-- SERVICES -->\n    <section class=\"services\" id=\"services\">\n        <h1 class=\"heading\">Our <span>Services</span></h1>\n\n        <div class=\"services-container\">\n            <div class=\"box\">\n                <i class=\"fas fa-stethoscope\"></i>\n                <h3>General Checkups</h3>\n                <p>Regular health examinations to ensure early detection and prevention.</p>\n                <a href=\"#\" class=\"btn\">Read More <span class=\"fas fa-chevron-right\"></span></a>\n            </div>\n\n            <div class=\"box\">\n                <i class=\"fas fa-ambulance\"></i>\n                <h3>Emergency Care</h3>\n                <p>24/7 emergency medical services with rapid response teams.</p>\n                <a href=\"#\" class=\"btn\">Read More <span class=\"fas fa-chevron-right\"></span></a>\n            </div>\n\n            <div class=\"box\">\n                <i class=\"fas fa-notes-medical\"></i>\n                <h3>Medical Reports</h3>\n                <p>Accurate diagnosis reports using modern medical technology.</p>\n                <a href=\"#\" class=\"btn\">Read More <span class=\"fas fa-chevron-right\"></span></a>\n            </div>\n\n            <div class=\"box\">\n                <i class=\"fas fa-pills\"></i>\n                <h3>Pharmacy Support</h3>\n                <p>On-site pharmacy with trusted medications and professional guidance.</p>\n                <a href=\"#\" class=\"btn\">Read More <span class=\"fas fa-chevron-right\"></span></a>\n            </div>\n\n            <div class=\"box\">\n                <i class=\"fas fa-heartbeat\"></i>\n                <h3>Cardiology</h3>\n                <p>Advanced heart care services delivered by expert cardiologists.</p>\n                <a href=\"#\" class=\"btn\">Read More <span class=\"fas fa-chevron-right\"></span></a>\n            </div>\n\n            <div class=\"box\">\n                <i class=\"fas fa-x-ray\"></i>\n                <h3>Diagnostic Imaging</h3>\n                <p>Modern imaging services including X-rays and ultrasound scans.</p>\n                <a href=\"#\" class=\"btn\">Read More <span class=\"fas fa-chevron-right\"></span></a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Our-Story -->\n    <section class=\"our-story\" id=\"our-story\">\n        <h1 class=\"heading\"> Our <span>Stroy</span> </h1>\n\n        <div class=\"our-stroy-container\">\n            <img src=\"Images/doctor_about.jpg\" alt=\"Medical team collaboration\" loading=\"lazy\">\n            <div class=\"our-stroy-content\">\n                <h2>Trusted Healthcare For Your Family</h2>\n                <p>\n                    At Healio , we believe in providing accessible, reliable, and patient-centered healthcare.\n                    Our mission is to improve lives through professional medical services.\n                </p>\n                <p>\n                    With years of experience and a dedicated medical staff, we ensure the highest standards\n                    of safety and care.\n                </p>\n                <a href=\"#\" class=\"btn\">Learn More <span class=\"fas fa-chevron-right\"></span></a>\n            </div>\n        </div>\n    </section>\n\n    <!-- DOCTORS -->\n    <section class=\"doctors\" id=\"doctors\">\n        <h1 class=\"heading\">Our <span>Doctors</span></h1>\n\n        <div class=\"doctors-container\">\n            <div class=\"doctor-box\">\n                <img src=\"Images/doctor_1.jpg\" alt=\"Senior medical doctor\" loading=\"lazy\">\n                <div class=\"doctor-info\">\n                    <h3>Dr. Hanein Ahmad</h3>\n                    <p>Senior Cardiologist</p>\n                </div>\n                <div class=\"doctor-social\">\n                    <a href=\"https://www.facebook.com/youssef.hanafy.23683/\" target=\"_blank\">\n                        <i class=\"fab fa-facebook-f\"></i>\n                    </a>\n                    <a href=\"https://wa.me/201100475722\" target=\"_blank\">\n                        <i class=\"fab fa-whatsapp\"></i>\n                    </a>\n                    <a href=\"https://www.linkedin.com/in/youssef-hanafy-7986342a8\" target=\"_blank\">\n                        <i class=\"fab fa-linkedin-in\"></i>\n                    </a>\n                </div>\n            </div>\n\n            <div class=\"doctor-box\">\n                <img src=\"Images/doctor_2.jpg\" alt=\"Medical specialist\" loading=\"lazy\">\n                <div class=\"doctor-info\">\n                    <h3>Dr. Sara Mohamed</h3>\n                    <p>Neurology Specialist</p>\n                </div>\n                <div class=\"doctor-social\">\n                    <a href=\"https://www.facebook.com/youssef.hanafy.23683/\" target=\"_blank\">\n                        <i class=\"fab fa-facebook-f\"></i>\n                    </a>\n                    <a href=\"https://wa.me/201100475722\" target=\"_blank\">\n                        <i class=\"fab fa-whatsapp\"></i>\n                    </a>\n                    <a href=\"https://www.linkedin.com/in/youssef-hanafy-7986342a8\" target=\"_blank\">\n                        <i class=\"fab fa-linkedin-in\"></i>\n                    </a>\n                </div>\n            </div>\n\n            <div class=\"doctor-box\">\n                <img src=\"Images/doctor_3.jpg\" alt=\"Experienced surgeon\" loading=\"lazy\">\n                <div class=\"doctor-info\">\n                    <h3>Dr. Omar Khaled</h3>\n                    <p>General Surgeon</p>\n                </div>\n                <div class=\"doctor-social\">\n                    <a href=\"https://www.facebook.com/youssef.hanafy.23683/\" target=\"_blank\">\n                        <i class=\"fab fa-facebook-f\"></i>\n                    </a>\n                    <a href=\"https://wa.me/201100475722\" target=\"_blank\">\n                        <i class=\"fab fa-whatsapp\"></i>\n                    </a>\n                    <a href=\"https://www.linkedin.com/in/youssef-hanafy-7986342a8\" target=\"_blank\">\n                        <i class=\"fab fa-linkedin-in\"></i>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- BOOK -->\n    <section class=\"book\" id=\"book\">\n        <h1 class=\"heading\"><span>Book</span> Now</h1>\n\n        <div class=\"book-container\">\n            <img src=\"Images/doctor_book.jpg\" alt=\"Online appointment booking\" loading=\"lazy\">\n\n            <div class=\"form\">\n                <h2>Schedule Your Appointment</h2>\n                <form>\n                    <input type=\"text\" placeholder=\"Full Name\" required=\"\">\n                    <input type=\"tel\" placeholder=\"Phone Number\" required=\"\">\n                    <input type=\"email\" placeholder=\"Email Address\" required=\"\">\n                    <input type=\"date\" required=\"\">\n                    <input type=\"submit\" value=\"Confirm Booking\">\n                </form>\n            </div>\n        </div>\n    </section>\n\n    <!-- REVIEWS -->\n    <section class=\"review\" id=\"review\">\n        <h1 class=\"heading\">Client <span>Reviews</span></h1>\n\n        <div class=\"review-container\">\n            <div class=\"client\">\n                <div class=\"client-info\">\n                    <img src=\"Images/custom_1.jpg\" alt=\"Satisfied patient\" loading=\"lazy\">\n                    <h3>Mohamed Adel</h3>\n                    <div class=\"client-stars\">\n                        <i class=\"fa-solid fa-star\"></i>\n                        <i class=\"fa-solid fa-star\"></i>\n                        <i class=\"fa-solid fa-star\"></i>\n                        <i class=\"fa-solid fa-star\"></i>\n                        <i class=\"fa-regular fa-star\"></i>\n                    </div>\n                </div>\n                <div class=\"client-about\">\n                    <p>\n                        I am truly impressed by the high standards of medical care at Healio. The staff is not only professional but also incredibly compassionate, making the entire process stress-free and smooth. From the initial consultation to the final follow-up, the attention to detail was remarkable. They utilize modern diagnostic tools that provided me with a clear understanding of my health status. It is rare to find a healthcare provider that balances advanced technology with such a personal, human touch.\n                    </p>\n                </div>\n            </div>\n\n            <div class=\"client\">\n                <div class=\"client-info\">\n                    <img src=\"Images/custom_2.jpg\" alt=\"Satisfied patient\" loading=\"lazy\">\n                    <h3>Ahmed Ali</h3>\n                    <div class=\"client-stars\">\n                        <i class=\"fa-solid fa-star\"></i>\n                        <i class=\"fa-solid fa-star\"></i>\n                        <i class=\"fa-solid fa-star\"></i>\n                        <i class=\"fa-solid fa-star\"></i>\n                        <i class=\"fa-solid fa-star\"></i>\n                    </div>\n                </div>\n                <div class=\"client-about\">\n                    <p>\n                        My experience with Healio has been exceptional in every way. From the moment I walked in, I felt truly cared for by the front desk team. The medical specialists here possess extensive expertise and take the time to listen to patient concerns, which is a rare quality these days. The procedures were incredibly organized and efficient, and I didn't have to wait long at all. I highly recommend their services to anyone seeking top-tier medical care and professional guidance.\n                    </p>\n                </div>\n            </div>\n\n            <div class=\"client\">\n                <div class=\"client-info\">\n                    <img src=\"Images/custom_3.jpg\" alt=\"Satisfied patient\" loading=\"lazy\">\n                    <h3>Ghad Essam</h3>\n                    <div class=\"client-stars\">\n                        <i class=\"fa-solid fa-star\"></i>\n                        <i class=\"fa-solid fa-star\"></i>\n                        <i class=\"fa-solid fa-star\"></i>\n                        <i class=\"fa-solid fa-star\"></i>\n                        <i class=\"fa-solid fa-star-half-stroke\"></i>\n                    </div>\n                </div>\n                <div class=\"client-about\">\n                    <p>\n                        What truly sets this medical center apart is the absolute cleanliness and the visible sterilization in every corner, combined with the use of the latest medical technologies. I followed up on my condition with a team of experts who were in constant contact with me even after the treatment ended to ensure my full recovery. The medical staff is extremely friendly and makes you feel like you are among family. Thank you Healio for this high level of dedicated service and care.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- BLOG -->\n    <section class=\"blogs\" id=\"blogs\">\n        <h1 class=\"heading\">Our <span>Blog</span></h1>\n\n        <div class=\"blog-container\">\n            <div class=\"blog-wrapper loading\">\n                <div class=\"blog-skeleton\">\n                    <div class=\"skel-img\"></div>\n                    <div class=\"skel-line w-60\"></div>\n                    <div class=\"skel-line w-90\"></div>\n                    <div class=\"skel-line w-40\"></div>\n                </div>\n                <div class=\"blog\">\n                    <img src=\"Images/blog_1.jpg\" alt=\"Care Advices\" loading=\"lazy\">\n                    <div class=\"blog-detail\">\n                        <div class=\"detail-time\">\n                            <i class=\"fa-solid fa-calendar\"></i>\n                            <p>Feb 6, 2026</p>\n                        </div>\n                        <div class=\"detail-user\">\n                            <i class=\"fa-solid fa-user\"></i>\n                            <p>Care Advices</p>\n                        </div>\n                    </div>\n                    <div class=\"blog-info\">\n                        <h3>How To Maintain A Healthy Lifestyle</h3>\n                        <p>Simple daily habits that can improve your physical and mental health.</p>\n                        <a href=\"#\" class=\"btn\">Read More <span class=\"fas fa-chevron-right\"></span></a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"blog-wrapper loading\">\n                <div class=\"blog-skeleton\">\n                    <div class=\"skel-img\"></div>\n                    <div class=\"skel-line w-60\"></div>\n                    <div class=\"skel-line w-90\"></div>\n                    <div class=\"skel-line w-40\"></div>\n                </div>\n                <div class=\"blog\">\n                    <img src=\"Images/blog_2.jpg\" alt=\"Vitamins\" loading=\"lazy\">\n                    <div class=\"blog-detail\">\n                        <div class=\"detail-time\">\n                            <i class=\"fa-solid fa-calendar\"></i>\n                            <p>Feb 5, 2026</p>\n                        </div>\n                        <div class=\"detail-user\">\n                            <i class=\"fa-solid fa-user\"></i>\n                            <p>Vitamins</p>\n                        </div>\n                    </div>\n                    <div class=\"blog-info\">\n                        <h3>The Importance Of Mental Wellness</h3>\n                        <p>Understanding the deep connection between mind and body for a balanced life.</p>\n                        <a href=\"#\" class=\"btn\">Read More <span class=\"fas fa-chevron-right\"></span></a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"blog-wrapper loading\">\n                <div class=\"blog-skeleton\">\n                    <div class=\"skel-img\"></div>\n                    <div class=\"skel-line w-60\"></div>\n                    <div class=\"skel-line w-90\"></div>\n                    <div class=\"skel-line w-40\"></div>\n                </div>\n\n                <div class=\"blog\">\n                    <img src=\"Images/blog_3.jpg\" alt=\"Healthy Food\" loading=\"lazy\">\n                    <div class=\"blog-detail\">\n                        <div>\n                            <i class=\"fa-solid fa-calendar\"></i>\n                            <p>Feb 4, 2026</p>\n                        </div>\n                        <div>\n                            <i class=\"fa-solid fa-user\"></i>\n               