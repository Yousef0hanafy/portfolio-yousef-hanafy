other > a' and '.main-nav > li.apper-other > .other-links'\");\n    }\n\n    // --- Update Copyright Year ---\n    const yearSpan = document.getElementById('currentYear');\n    if (yearSpan) {\n        yearSpan.textContent = new Date().getFullYear();\n    }\n\n    // --- Duration-Based Countdown Timer Logic ---\n    const countdownTimerElement = document.getElementById('countdown-timer');\n    if (countdownTimerElement) {\n        // Set the initial duration for the countdown in seconds\n        const initialDurationInSeconds = 24 * 60 * 60; // 24 hours\n        let remainingTimeInSeconds = initialDurationInSeconds;\n\n        const daysEl = document.getElementById('countdown-days');\n        const hoursEl = document.getElementById('countdown-hours');\n        const minutesEl = document.getElementById('countdown-minutes');\n        const secondsEl = document.getElementById('countdown-seconds');\n\n        if (daysEl && hoursEl && minutesEl && secondsEl) {\n            const updateCountdown = () => {\n                if (remainingTimeInSeconds < 0) {\n                    clearInterval(countdownInterval);\n                    countdownTimerElement.innerHTML = \"<p style='font-size: 1.5em; text-align: center; color: var(--main-color);'>Time's up!</p>\";\n                    return;\n                }\n                const days = Math.floor(remainingTimeInSeconds / (60 * 60 * 24));\n                const hours = Math.floor((remainingTimeInSeconds % (60 * 60 * 24)) / (60 * 60));\n                const minutes = Math.floor((remainingTimeInSeconds % (60 * 60)) / 60);\n                const seconds = Math.floor(remainingTimeInSeconds % 60);\n\n                // Add leading zeros if number is less than 10\n                daysEl.textContent = days < 10 ? '0' + days : days;\n                hoursEl.textContent = hours < 10 ? '0' + hours : hours;\n                minutesEl.textContent = minutes < 10 ? '0' + minutes : minutes;\n                secondsEl.textContent = seconds < 10 ? '0' + seconds : seconds;\n\n                remainingTimeInSeconds--;\n            };\n            updateCountdown();\n            const countdownInterval = setInterval(updateCountdown, 1000);\n        } else {\n            console.warn(\"Could not find all countdown span elements.\");\n        }\n    }\n});\n</script>\n\n</body></html>",
