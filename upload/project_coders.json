ime\">\n                <div class=\"img-holder\">\n                    <img src=\"Images/Pics/s_2.jpg\" alt=\"Toolkits Icon\">\n                </div>\n                <div class=\"content\">\n                    <h3>Resource Toolkits</h3>\n                    <p>Access templates, checklists, and guides to streamline your freelance workflow.</p>\n                    <a href=\"#\">Get Resources</a>\n                </div>\n            </div>\n            <div class=\"box passion\">\n                <div class=\"img-holder\">\n                    <img src=\"Images/Pics/s_3.jpg\" alt=\"Community Icon\">\n                </div>\n                <div class=\"content\">\n                    <h3>Community Support</h3>\n                    <p>Connect with fellow creatives, share experiences, and get feedback.</p>\n                    <a href=\"#\">Join Community</a>\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"spikes\"></div>\n    <div class=\"testimonials\" id=\"testimonials\">\n        <h2 class=\"main-title\">Success Stories</h2>\n        <div class=\"dots dots-up\" aria-hidden=\"true\"></div>\n        <div class=\"dots dots-down\" aria-hidden=\"true\"></div>\n        <div class=\"container\">\n            <div class=\"box\">\n                <img src=\"Images/Icon/man_2.png\" alt=\"Youssef Hanafy, Full-Stack Developer\">\n                <h3>Youssef Hanafy</h3>\n                <span class=\"title\">Full-Stack Developer</span>\n                <div class=\"rate\" role=\"img\" aria-label=\"4.5 out of 5 stars\">\n                    <i class=\"filled fa-solid fa-star\" aria-hidden=\"true\"></i>\n                    <i class=\"filled fa-solid fa-star\" aria-hidden=\"true\"></i>\n                    <i class=\"filled fa-solid fa-star\" aria-hidden=\"true\"></i>\n                    <i class=\"filled fa-solid fa-star\" aria-hidden=\"true\"></i>\n                    <i class=\"filled fa-solid fa-star-half-stroke\" aria-hidden=\"tr